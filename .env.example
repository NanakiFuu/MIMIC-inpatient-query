# Template only; no real secrets here.
# The real Compose env is generated at a Linux-private path (not the Windows mount,
# because DrvFs does not enforce chmod): /var/lib/medical-query/compose/.env
# scripts/prepare_compose.py writes it; scripts/compose.sh and install_compose.sh
# read it via `docker compose --env-file`. Override with MEDICAL_QUERY_COMPOSE_ENV.
MEDICAL_QUERY_HTTP_PORT=18765
MEDICAL_QUERY_POSTGRES_PORT=15432
MEDICAL_QUERY_VERSION=0.3.0
POSTGRES_IMAGE=postgres:16-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_PASSWORD=
MEDICAL_QUERY_DB_PASSWORD=
DEEPSEEK_API_KEY=
# Store passwords/API key only in local private configuration or ignored .env.
# Existing systemd uses ~/.config/medical-query/{database,model}.json.
