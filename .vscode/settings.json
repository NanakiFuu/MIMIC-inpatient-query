{
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.encoding": "utf8",

  "python.defaultInterpreterPath": "${env:HOME}/environments/medical-query/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "search.exclude": {
    "**/evidence/**": true,
    "**/research/**": true,
    "**/mimic-iv-clinical-database-demo-*/**": true,
    "**/__pycache__/**": true,
    "**/*.pyc": true,
    "**/.venv/**": true
  },
  "files.watcherExclude": {
    "**/evidence/**": true,
    "**/research/**": true,
    "**/mimic-iv-clinical-database-demo-*/**": true,
    "**/.venv/**": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  "shellcheck.enable": true,
  "shellcheck.run": "onSave",
  "[shellscript]": {
    "editor.tabSize": 2
  }
}
